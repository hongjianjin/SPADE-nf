/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SPADE-nf Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

params {

    // Input / output
    counts                  = null
    meta                    = null
    comparisons             = null
    species                 = null
    outdir                  = null
    prefix                  = null   // default: SPADE, or the SRM name / mergedSRMs_<n> (CAB internal)

    // Differential expression (spade_de.R; changing these re-runs SPADE_DE)
    ercc                    = true
    filter_noncoding        = true
    cutoff_count            = 0
    cutoff_cpm              = 0

    // Report (spade_report.R; changing these re-runs SPADE_REPORT only)
    cutoff_log2fc           = 1
    cutoff_pvalue           = 0.05
    cutoff_fdr              = 0.05
    topn_deg                = 10
    num_gene_pca            = 3000
    volcano                 = false

    // fgsea
    run_fgsea               = true
    fgsea_gene_sets         = 'default'
    fgsea_rank_metric       = 't'
    fgsea_pval_cutoff       = 0.05
    fgsea_top_n             = 10
    custom_gmt              = null
    msigdb_version          = '2026.2'
    msigdb_dir              = null
    msigdb_base_url         = 'https://data.broadinstitute.org/gsea-msigdb/msigdb/release'

    // Enrichr (web API, needs internet on compute nodes)
    run_enrichr             = false
    enrichr_dbs             = 'standard'
    enrichr_top_genes       = 250
    enrichr_rank_metric     = 't'

    // Report header
    project_name            = null
    pi_name                 = null
    project_lead            = null
    lead_analysts           = null
    group_lead              = null
    contact_email           = null
    department              = null
    task_id                 = null
    start_date              = null

    // CAB internal (AutoMapper inputs, multi-SRM merge, CAB report branding)
    cab_internal            = false
    input                   = null
    automapper_dir          = null
    srm                     = null
    mapping_report          = null
    mapping_qc              = null

    // Software container: R + Bioconductor + SPADE function files in /opt/spade
    spade_version           = '3.0.1'
    spade_container         = 'ghcr.io/hongjianjin/spade:3.0.1'

    // Boilerplate options
    publish_dir_mode        = 'copy'
    monochrome_logs         = false
    help                    = false
    help_full               = false
    show_hidden             = false
    version                 = false
    trace_report_suffix     = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params         = true
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions (provides -profile stjude)
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

docker.registry       = 'quay.io'
singularity.registry  = 'quay.io'
apptainer.registry    = 'quay.io'

// Keep host Python/R libraries out of the container
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    R_LIBS_USER      = "/dev/null"
    // Override a host R_LIBS (e.g. a personal R library) that Singularity would pass into the
    // container; these are the container's own library paths.
    R_LIBS           = "/usr/local/lib/R/site-library:/usr/local/lib/R/library"
    SPADE_HOME       = "/opt/spade"
}

process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all succeed
]

nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'SPADE-nf'
    contributors    = [
        [
            name: 'Hongjian Jin',
            affiliation: "St. Jude Children's Research Hospital",
            email: '',
            github: 'hongjianjin',
            contribution: ['author', 'maintainer'],
            orcid: '0000-0003-3833-7170'
        ],
    ]
    homePage        = 'https://github.com/hongjianjin/SPADE-nf'
    description     = """ERCC spike-in aware RNA-seq differential expression and enrichment with SPADE"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.10.0'
    version         = '3.0.1'
    doi             = ''
}

plugins {
    id 'nf-schema@2.4.2'
}

validation {
    monochromeLogs = params.monochrome_logs
    help {
        enabled = true
        command = "nextflow run hongjianjin/SPADE-nf -profile <docker/singularity/stjude> --counts counts.txt --meta sample_meta.txt --species human --outdir <OUTDIR>"
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
    }
}

includeConfig 'conf/modules.config'
