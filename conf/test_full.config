/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for a full-size test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SPADE example 3 with all default MSigDB gene sets and Enrichr:

        nextflow run hongjianjin/SPADE-nf -profile test_full,stjude --outdir results_test_full
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'SPADE example 3 with all default fgsea gene sets and Enrichr'

    counts       = 'https://raw.githubusercontent.com/hongjianjin/SPADE/3.0.1/data/Example3_RSEM_with_ERCC_count.txt'
    meta         = 'https://raw.githubusercontent.com/hongjianjin/SPADE/3.0.1/data/Example3_sample_meta.txt'
    species      = 'mouse'
    prefix       = 'EX3'
    run_enrichr  = true
    project_name = 'SPADE-nf full test (SPADE example 3)'
}
