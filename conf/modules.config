/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Each process gets only its own options in ext.args, so changing an option with
    -resume re-runs only the steps that use it.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MERGE_SRMS' {
        publishDir = [
            path: { "${params.outdir}/merged_srms" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'VALIDATE_INPUTS' {
        publishDir = [
            path: { "${params.outdir}/input" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Count/CPM filters, gene filter and ERCC switch. DEG cutoffs are report-only.
    withName: 'SPADE_DE' {
        ext.args = { [
            "--ERCC ${params.ercc ? 'TRUE' : 'FALSE'}",
            "--filter ${params.filter_noncoding ? 'TRUE' : 'FALSE'}",
            "--countCutoff ${params.cutoff_count}",
            "--cpmCutoff ${params.cutoff_cpm}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/de" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FGSEA' {
        ext.args = { [
            "--rank_metric ${params.fgsea_rank_metric}",
            "--pval_cutoff ${params.fgsea_pval_cutoff}",
            "--top_n ${params.fgsea_top_n}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/enrichment/fgsea/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ENRICHR' {
        ext.args = { [
            "--dbs ${params.enrichr_dbs}",
            "--top_genes ${params.enrichr_top_genes}",
            "--rank_metric ${params.enrichr_rank_metric}",
            "--top_n ${params.fgsea_top_n}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/enrichment/enrichr/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPADE_REPORT' {
        ext.args = { [
            "--branding ${params.cab_internal ? 'cab' : 'spade'}",
            "--volcano ${params.volcano ? 'TRUE' : 'FALSE'}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
