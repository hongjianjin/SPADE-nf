/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running a small real test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SPADE example 3 (mouse, 9 samples, ERCC spike-ins), read from the SPADE repository
    at tag 3.0.1, so it runs from any launch directory (needs internet access):

        nextflow run hongjianjin/SPADE-nf -profile test,singularity --outdir results_test

    Add -stub to check the wiring only (placeholder outputs, a few seconds).
----------------------------------------------------------------------------------------
*/

// Runs with the local executor on a login or 1-core interactive node.
process {
    resourceLimits = [
        cpus: 1,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'SPADE example 3: mouse, 9 samples, ERCC spike-ins, one comparison'

    counts          = 'https://raw.githubusercontent.com/hongjianjin/SPADE/3.0.1/data/Example3_RSEM_with_ERCC_count.txt'
    meta            = 'https://raw.githubusercontent.com/hongjianjin/SPADE/3.0.1/data/Example3_sample_meta.txt'
    species         = 'mouse'
    prefix          = 'EX3'
    fgsea_gene_sets = 'Hallmark'
    project_name    = 'SPADE-nf test (SPADE example 3)'
}
