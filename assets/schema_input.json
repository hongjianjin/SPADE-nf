{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/hongjianjin/SPADE-nf/main/assets/schema_input.json",
    "title": "SPADE-nf pipeline - params.input schema (CAB internal SRM sheet)",
    "description": "One row per AutoMapper SRM. Used with --cab_internal --input srms.csv; several rows are merged.",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "srm": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "errorMessage": "SRM name must be provided and may only contain letters, digits, '.', '_' and '-'",
                "meta": ["id"]
            },
            "counts": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.txt$",
                "errorMessage": "RSEM count matrix must exist and end in '.txt'"
            },
            "report": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.report$",
                "errorMessage": "AutoMapper report must exist and end in '.report'"
            },
            "tpm": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.txt$",
                "errorMessage": "TPM matrix must exist and end in '.txt'"
            },
            "fpkm": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.txt$",
                "errorMessage": "FPKM matrix must exist and end in '.txt'"
            }
        },
        "required": ["srm", "counts"]
    },
    "uniqueEntries": ["srm"]
}
